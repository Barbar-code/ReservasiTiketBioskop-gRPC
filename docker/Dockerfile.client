# docker/Dockerfile.client — image CLI client (tugas Anggota 2)
FROM python:3.11-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1

RUN pip install --no-cache-dir grpcio grpcio-tools

COPY proto/ ./proto/
COPY client/ ./client/

RUN python -m grpc_tools.protoc -I proto --python_out=. --grpc_python_out=. proto/bioskop.proto

# Tanpa argumen → menu interaktif (bagus untuk demo dengan -it).
CMD ["python", "-m", "client.main"]
